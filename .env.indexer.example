# Stellar Bazaar Soroban Event Indexer Configuration
# Copy this file to .env.indexer and modify values for your target deployment.

# Soroban RPC Endpoint
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://mainnet.sorobanrpc.com
# Local standalone: http://localhost:8000/soroban/rpc
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# Network Passphrase
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; July 2015"
# Local standalone: "Standalone Network ; February 2024"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Smart Contract Addresses (Soroban Contract IDs)
DEMAND_CIRCLE_REGISTRY_ID="CDCK6A2QB5QTILDWILUQGAUWXI543TK63WN2OKG7WEWHBAMGZ6ESKY4G"
BAZAAR_DEAL_ENGINE_ID="CCBYK4O47SCLF6Q5F773R4U2W7Z26S4JGB27F5O6H2N72B3Z37Y2P6P7"

# Persistence Storage
# File path for SQLite relational database (use ":memory:" for ephemeral test environments)
INDEXER_DB_PATH="./bazaar_indexer.db"

# Polling Mechanics
# Frequency in milliseconds between Soroban RPC getEvents requests (default: 3000ms = 3s)
INDEXER_POLL_INTERVAL_MS=3000

# Event batching limit per RPC roundtrip (max 1000)
INDEXER_BATCH_SIZE=100

# Optional starting ledger sequence (leave empty to resume from checkpoint or genesis)
# INDEXER_START_LEDGER=123456

# Observability Ports
INDEXER_HEALTH_PORT=8088
INDEXER_METRICS_PORT=9090
