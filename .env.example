# Stellar Bazaar Core Environment Variables (Example Only - Do Not Commit Real Secrets)

# Stellar Network Configuration
STELLAR_NETWORK=TESTNET
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Smart Contract IDs (Populated upon Testnet deployment)
BAZAAR_DEAL_ENGINE_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
BAZAAR_ESCROW_CONTRACT_ID=CBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

# Operator / Admin Public Key (Public addresses only)
OPERATOR_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgres://bazaar_user:bazaar_password@localhost:5432/stellar_bazaar
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_SECONDS=30

# Indexer Configuration
INDEXER_START_LEDGER=0
INDEXER_POLL_INTERVAL_MS=3000
INDEXER_BATCH_SIZE=100

# Backend Service
PORT=8080
LOG_LEVEL=info
