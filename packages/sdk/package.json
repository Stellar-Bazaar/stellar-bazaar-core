{
  "name": "@stellar-bazaar/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for interacting with Stellar Bazaar cooperative demand circles and Soroban smart contracts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "stellar",
    "soroban",
    "smart-contracts",
    "cooperative",
    "group-buying",
    "sdk",
    "web3"
  ],
  "author": "KingTaiwoDev",
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

